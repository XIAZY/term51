<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>io.github.xiazy.term51</id>
    <name>term51</name>
    <versionNumber>0.0.2</versionNumber>
    <buildId>2</buildId>
    <description>Terminal emulator for BlackBerry 10.</description>
    <author>AlphaToad</author>

    <icon>
        <image>assets/icon.png</image>
    </icon>

    <initialWindow>
        <autoOrients>true</autoOrients>
        <systemChrome>none</systemChrome>
    </initialWindow>

    <configuration name="Device-Debug">
        <platformArchitecture>armle-v7</platformArchitecture>
        <asset path="build/term51" entry="true" type="Qnx/Elf">term51</asset>
        <!-- BusyBox: the tools the phone lacks (head, tr, ...) and the BusyBox
             shell. tools/busybox.sh fetches it; its licences are beside it. -->
        <asset path="build/busybox/busybox" type="Qnx/Elf">busybox/busybox</asset>
        <!-- The Dropbear SSH client: ssh, scp and its key tools, one program.
             tools/dropbear.sh builds it; its licences are beside it. -->
        <asset path="build/dropbear/dropbearmulti" type="Qnx/Elf">dropbear/dropbearmulti</asset>
    </configuration>

    <asset path="assets">assets</asset>
    <asset path="third_party/busybox">busybox/licences</asset>
    <!-- The BusyBox shell's start-up file: a prompt that reports the
         directory, which names the tab (shell/ashrc). -->
    <asset path="shell/ashrc">busybox/ashrc</asset>
    <!-- Dropbear's licences, from its source (the submodule), and term51's
         notes on it. -->
    <asset path="third_party/dropbear/LICENSE">dropbear/licences/LICENSE</asset>
    <asset path="third_party/dropbear/libtomcrypt/LICENSE">dropbear/licences/libtomcrypt.LICENSE</asset>
    <asset path="third_party/dropbear/libtommath/LICENSE">dropbear/licences/libtommath.LICENSE</asset>
    <asset path="third_party/dropbear.README">dropbear/licences/README</asset>

    <permission system="true">run_native</permission>
    <env var="LD_LIBRARY_PATH" value="/usr/lib/qt4/lib"/>
    <env var="CASCADES_THEME" value="dark"/>
</qnx>
